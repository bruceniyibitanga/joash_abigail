# Copy to .env.local and fill in. .env* is gitignored.

# Supabase project: vkouqiarorgvlrlorott
NEXT_PUBLIC_SUPABASE_URL=https://vkouqiarorgvlrlorott.supabase.co

# Publishable ("anon") key — safe to expose to the browser.
# Dashboard > Project Settings > API keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Service-role key — SERVER ONLY, bypasses RLS. Never prefix with NEXT_PUBLIC_.
# Used solely for the public RSVP upsert. Dashboard > Project Settings > API keys
SUPABASE_SECRET_KEY=
